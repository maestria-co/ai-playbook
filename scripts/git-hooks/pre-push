#!/usr/bin/env bash
# pre-push — run the same checks CI runs, before anything leaves this machine.
#
# Deliberately the SAME command as .github/workflows/validate.yml. If the two
# ever diverge, a push passes locally and fails in CI, and people start
# ignoring the hook. One check, two places it runs.
#
# Install once for every repo on this machine:
#   git config --global core.hooksPath <path-to-ai-playbook>/scripts/git-hooks
#
# Skip a single push (use sparingly, CI still enforces):
#   git push --no-verify

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# core.hooksPath is global, so this hook fires in every repo on the machine.
# Only act where there is something to check.
validator="$repo_root/scripts/validate.py"
[[ -f "$validator" ]] || exit 0

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-push: python3 not found, skipping validation (CI will still run it)" >&2
  exit 0
fi

echo "pre-push: running structural validation..."

if python3 "$validator" --strict; then
  exit 0
fi

cat >&2 <<'MSG'

Push rejected: structural validation failed.

The same check runs in CI, so this push would have gone red anyway.
Fix the errors above, or bypass with:

  git push --no-verify

See .context/decisions/ADR-002-level-4-ai-engineering.md
MSG
exit 1
